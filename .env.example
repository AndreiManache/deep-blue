ANTHROPIC_API_KEY=sk-ant-...
PORT=3001
DEEPBLUE_USERNAME=there

# Optional — leave unset for local dev (no access gate, everything resolves
# to a fixed "andrei" identity). Set this when deploying publicly: maps each
# access code to the user identity it should see — its own isolated profile
# and food log, invisible to every other code. Format: "code:user_id,..."
# e.g. "andrei23:andrei,Maria:maria". The frontend needs no changes; each
# person just enters their own code via the one-time "enter access code"
# prompt, same UI either way.
ACCESS_CODES=

# Optional — leave unset for local dev (uses a file next to the server
# source). Set this on a host to point at a persistent volume, e.g.
# /data/deepblue.db, so the database survives redeploys.
DEEPBLUE_DB_PATH=

# Optional — leave unset to use the browser's free speechSynthesis for
# everything (original behavior). Set this to have the backend synthesize
# AI reply audio via ElevenLabs instead (higher quality, costs per
# character; requires a paid ElevenLabs plan — the free tier blocks API
# voice access entirely). The greeting and local error phrases always stay
# on speechSynthesis regardless, by design — see BACKLOG.md.
ELEVENLABS_API_KEY=
# Optional — defaults to "Rachel" (21m00Tcm4TlvDq8ikWAM), a premade voice.
ELEVENLABS_VOICE_ID=
