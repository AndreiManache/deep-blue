ANTHROPIC_API_KEY=sk-ant-...
PORT=3001
DEEPBLUE_USERNAME=there

# Auth is now username + password accounts (open self sign-up) — no env var
# to configure. Accounts and session tokens live in the SQLite database
# (DEEPBLUE_DB_PATH), so point that at a persistent volume in production or
# everyone is logged out (and every account lost) on redeploy. A user who
# registers the username "andrei" inherits any data left under that id by the
# earlier access-code deployment.

# Optional — leave unset for local dev (uses a file next to the server
# source). Set this on a host to point at a persistent volume, e.g.
# /data/deepblue.db, so the database survives redeploys.
DEEPBLUE_DB_PATH=

# Used for BOTH text-to-speech (AI reply audio) AND speech-to-text (the
# server transcribes the user's spoken turn via ElevenLabs Scribe, since the
# browser's own speech recognition is unreliable on iOS). Requires a paid
# ElevenLabs plan with Speech-to-Text enabled — the free tier blocks API
# access. If unset, TTS falls back to the browser's speechSynthesis, but
# speech input (/transcribe) returns a 503 and the voice conversation can't
# work — so on a real deployment this must be set.
ELEVENLABS_API_KEY=
# Optional — defaults to "Rachel" (21m00Tcm4TlvDq8ikWAM), a premade voice.
ELEVENLABS_VOICE_ID=

# Comma-separated list of usernames (normalized: lowercase) allowed to hit
# /admin/* (currently just the feedback inbox). Unset means nobody is an
# admin. Also set VITE_ADMIN_USERNAME to the same value in web/.env (same
# comma-separated shape) so the "Feedback inbox" menu item shows up for that
# account — that check is UI-only, the real gate is this server-side var.
ADMIN_USERNAMES=

# --- Provider switches — see PROVIDERS.md for the full guide -------------

# "anthropic" (default) or "gemini" — which LLM answers /chat turns.
LLM_PROVIDER=anthropic
# "elevenlabs" (default) or "gemini" — which service synthesizes reply audio.
# Independent of LLM_PROVIDER: either LLM can pair with either voice.
TTS_PROVIDER=elevenlabs

# Required if LLM_PROVIDER=gemini or TTS_PROVIDER=gemini. Get one at
# aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional overrides — sane defaults are baked in (see config.ts).
GEMINI_MODEL=
GEMINI_THINKING_LEVEL=
GEMINI_TTS_MODEL=
GEMINI_VOICE_NAME=
GEMINI_VOICE_NAME_RO=

# Optional STT speedup for English speakers — Smallest AI's Pulse Pro model.
# English-only, so it's only ever used for a profile with a confirmed
# language:"en" preference; Romanian and language-unknown turns always use
# ElevenLabs Scribe regardless of this key. Leave unset to always use
# Scribe (today's behavior). Get one at smallest.ai (console → API keys).
SMALLESTAI_API_KEY=
