ANTHROPIC_API_KEY=sk-ant-...
PORT=3001
DEEPBLUE_USERNAME=there

# Optional — leave unset for local dev (no access gate). Set this when
# deploying publicly; the frontend will then require it via a one-time
# "enter access code" prompt before any API call succeeds.
ACCESS_CODE=

# Optional — leave unset for local dev (uses a file next to the server
# source). Set this on a host to point at a persistent volume, e.g.
# /data/deepblue.db, so the database survives redeploys.
DEEPBLUE_DB_PATH=
