ANTHROPIC_API_KEY=sk-ant-...
PORT=3001
DEEPBLUE_USERNAME=there

# Auth is now username + password accounts (open self sign-up) — no env var
# to configure. Accounts and session tokens live in the SQLite database
# (DEEPBLUE_DB_PATH), so point that at a persistent volume in production or
# everyone is logged out (and every account lost) on redeploy. A user who
# registers the username "andrei" inherits any data left under that id by the
# earlier access-code deployment.

# Optional — leave unset for local dev (uses a file next to the server
# source). Set this on a host to point at a persistent volume, e.g.
# /data/deepblue.db, so the database survives redeploys.
DEEPBLUE_DB_PATH=

# Used for BOTH text-to-speech (AI reply audio) AND speech-to-text (the
# server transcribes the user's spoken turn via ElevenLabs Scribe, since the
# browser's own speech recognition is unreliable on iOS). Requires a paid
# ElevenLabs plan with Speech-to-Text enabled — the free tier blocks API
# access. If unset, TTS falls back to the browser's speechSynthesis, but
# speech input (/transcribe) returns a 503 and the voice conversation can't
# work — so on a real deployment this must be set.
ELEVENLABS_API_KEY=
# Optional — defaults to "Rachel" (21m00Tcm4TlvDq8ikWAM), a premade voice.
ELEVENLABS_VOICE_ID=
